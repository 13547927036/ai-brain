{
  "name": "huffcat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "哈气猫",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch --preserveWatchOutput",
    "dev": "tsc && node tools/dev-server.mjs",
    "serve": "node tools/dev-server.mjs",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "balance": "tsc && node tools/balance.mjs",
    "bench": "tsc && node --test --test-reporter=dot \"dist/render/**/*.test.js\"",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:imports": "node tools/check-imports.mjs",
    "build:wechat": "node tools/build-wechat.mjs",
    "build:cf": "node tools/build-cf.mjs",
    "deploy:cf": "node tools/build-cf.mjs && npx wrangler pages deploy .deploy/cf --project-name huffcat --branch main"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^24.0.0"
  }
}